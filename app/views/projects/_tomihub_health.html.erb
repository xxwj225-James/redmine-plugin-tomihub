<%= stylesheet_link_tag 'redmine_tomihub', plugin: :redmine_tomihub %>
<%
  # Free-tier health card + knowledge map block. Server-side render —
  # TomiHub only needs to be reachable from THIS Redmine server. Cached 60s.
  settings = Setting.plugin_redmine_tomihub
  configured = settings['tomihub_url'].present? && settings['api_key'].present?
  summary = nil
  knowledge = nil
  fetch_error = false
  if configured
    begin
      lang = ::I18n.locale.to_s.split('-').first
      client = RedmineTomihub::Client.new(settings['tomihub_url'], settings['api_key'])
      summary = Rails.cache.fetch("tomihub_summary_#{project.id}_#{lang}", expires_in: 60.seconds) do
        client.project_summary(project.id, lang)['data']
      end
    rescue RedmineTomihub::Client::Error, StandardError
      fetch_error = true
    end
    # Knowledge map is optional — its failure must not break the health card
    begin
      knowledge = Rails.cache.fetch("tomihub_kmap_#{project.id}", expires_in: 300.seconds) do
        RedmineTomihub::Client.new(settings['tomihub_url'], settings['api_key'])
                             .knowledge_map(project.id)['data']
      end
    rescue RedmineTomihub::Client::Error, StandardError
      knowledge = nil
    end
  end
  score = summary && summary['health_score']
  level = summary && summary['health_level']
  stats = (summary && summary['stats']) || {}
  trend = (summary && summary['trend']) || []
  # Risk dot color by category keyword (no emojis — neutral dots like TomiHub)
  def risk_dot_class(title)
    t = title.to_s.downcase
    if t.include?('bug') || t.include?('quality')
      'dot-quality'
    elsif t.include?('overdue') || t.include?('stalled') || t.include?('ratio') || t.include?('outpace')
      'dot-delivery'
    elsif t.include?('unassigned') || t.include?('overload')
      'dot-resources'
    else
      'dot-default'
    end
  end
  def sparkline_points(trend, plot_l = 30, plot_r = 226, plot_t = 8, plot_b = 52)
    return '' if trend.length < 2
    scores = trend.map { |t| t['score'].to_i }
    min = scores.min; max = scores.max
    range = (max - min).zero? ? 1 : (max - min)
    step_x = (plot_r - plot_l).to_f / (scores.length - 1)
    scores.each_with_index.map do |s, i|
      x = (plot_l + i * step_x).round(1)
      y = (plot_b - ((s - min) * (plot_b - plot_t) / range.to_f)).round(1)
      "#{x},#{y}"
    end.join(' ')
  end
  def trend_minmax(trend)
    scores = trend.map { |t| t['score'].to_i }
    [scores.min, scores.max]
  end
  def trend_dates(trend)
    first = (trend.first && trend.first['time'].to_s)[0, 10]
    last = (trend.last && trend.last['time'].to_s)[0, 10]
    [first, last]
  end
%>

<% if !configured %>
  <div class="box tomihub-setup-prompt">
    <p><strong><%= l(:tomihub_unconfigured_title) %></strong></p>
    <p><%= l(:tomihub_unconfigured_hint) %></p>
    <p class="tomihub-setup-cta">
      <a class="tomihub-cta-btn" href="<%= tomihub_guide_path %>">
        <%= l(:tomihub_get_started) %> →
      </a>
    </p>
    <p class="tomihub-early-bird">🎉 <%= l(:tomihub_early_bird) %></p>
  </div>
<% elsif fetch_error %>
  <div class="box tomihub-setup-prompt">
    <p><%= l(:tomihub_unreachable) %></p>
  </div>
<% elsif score.nil? %>
  <div class="box tomihub-setup-prompt">
    <p><%= l(:tomihub_no_data) %></p>
  </div>
<% else %>
  <div class="box" id="tomihub-health">
    <div class="tomihub-card tomihub-<%= level %>">
      <div class="tomihub-main">
        <div class="tomihub-score-wrap">
          <span class="tomihub-score"><%= score %></span>
          <span class="tomihub-level"><%= l("tomihub_level_#{level}") %></span>
        </div>
        <div class="tomihub-stats">
          <span class="stat stat-open"><strong><%= stats['open'] %></strong> <%= l(:tomihub_stat_open) %></span>
          <span class="stat stat-done"><strong><%= stats['done'] %></strong> <%= l(:tomihub_stat_done) %></span>
          <span class="stat stat-bugs"><strong><%= stats['bugs'] %></strong> <%= l(:tomihub_stat_bugs) %></span>
        </div>
        <% if trend.length >= 2 %>
          <% tmin, tmax = trend_minmax(trend) %>
          <% tfirst, tlast = trend_dates(trend) %>
          <div class="tomihub-trend">
            <span class="tomihub-trend-label"><%= l(:tomihub_trend_14d) %></span>
            <svg width="236" height="66" viewBox="0 0 236 66" aria-hidden="true">
              <!-- y-axis: score ticks (min at bottom, max at top) -->
              <line x1="26" y1="8" x2="226" y2="8" class="trend-grid"/>
              <line x1="26" y1="52" x2="226" y2="52" class="trend-grid"/>
              <text x="22" y="12" class="trend-axis" text-anchor="end"><%= tmax %></text>
              <text x="22" y="55" class="trend-axis" text-anchor="end"><%= tmin %></text>
              <!-- x-axis: date range -->
              <text x="30" y="64" class="trend-axis"><%= tfirst %></text>
              <text x="226" y="64" class="trend-axis" text-anchor="end"><%= tlast %></text>
              <polyline points="<%= sparkline_points(trend) %>"
                fill="none" stroke="#5e6ad2"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        <% end %>
      </div>

      <% risks = (summary['top_risks'] || []).first(3) %>
      <% if risks.any? %>
        <ul class="tomihub-risks">
          <% risks.each do |r| %>
            <li class="risk-item">
              <div class="risk-head">
                <span class="risk-dot <%= risk_dot_class(r['title']) %>"></span>
                <span class="risk-text"><%= r['title'] %></span>
              </div>
              <% issues = r['issues'] || [] %>
              <% if issues.any? %>
                <div class="risk-issues">
                  <% issues.each do |iss| %>
                    <% rid = iss['redmine_id'] || iss['number'] %>
                    <a class="issue-link" target="_blank" rel="noopener"
                       href="/issues/<%= rid %>">
                      #<%= rid %> <%= iss['title'].to_s.truncate(40) %>
                    </a>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <p class="tomihub-cta">
        <a class="tomihub-cta-btn" href="<%= settings['tomihub_url'] %>" target="_blank" rel="noopener">
          <%= l(:tomihub_full_analysis) %> →
        </a>
        <span class="tomihub-updated"><%= l(:tomihub_updated) %> <%= summary['updated_at'].to_s[0, 16].gsub('T', ' ') %></span>
      </p>
      <p class="tomihub-powered">
        <%= l(:tomihub_powered_by) %> <a href="https://tomatovector.com/tomihub" target="_blank" rel="noopener">TomiHub</a>
        · <span class="tomihub-early-bird-inline">🎉 <%= l(:tomihub_early_bird_short) %></span>
      </p>
    </div>

    <% pages = (knowledge && knowledge['pages']) || [] %>
    <% ai = knowledge && knowledge['ai'] %>
    <% if pages.any? || ai %>
      <div class="tomihub-card tomihub-kmap">
        <p class="tomihub-kmap-title"><%= l(:tomihub_kmap_title) %>
          <% if pages.any? %>
            <span class="tomihub-kmap-meta">· <%= pages.size %> <%= l(:tomihub_kmap_pages_label) %></span>
          <% end %>
        </p>
        <% if ai %>
          <div class="tomihub-kmap-ai">
            <p class="kmap-ai-summary"><%= ai['summary'] %></p>
            <% if ai['progress'].present? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_progress) %></strong> <%= ai['progress'] %></p>
            <% end %>
            <% if ai['team_overview'].present? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_team) %></strong> <%= ai['team_overview'] %></p>
            <% end %>
            <% if ai['team_expertise'].present? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_expertise) %></strong> <%= ai['team_expertise'] %></p>
            <% end %>
            <% if ai['architecture'].present? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_architecture) %></strong> <%= ai['architecture'] %></p>
            <% end %>
            <% decisions = ai['key_decisions'] || [] %>
            <% if decisions.any? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_decisions) %></strong></p>
              <ul class="kmap-ai-steps">
                <% decisions.each do |kd| %>
                  <li><%= kd.is_a?(Hash) ? (kd['decision'] || kd['title'] || kd.to_s) : kd.to_s %></li>
                <% end %>
              </ul>
            <% end %>
            <% complex = ai['complex_issues'] || [] %>
            <% if complex.any? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_complex) %></strong></p>
              <ul class="kmap-ai-steps">
                <% complex.each do |ci| %>
                  <li>#<%= ci['number'] %> <%= ci['title'].to_s.truncate(48) %>
                    <span class="kmap-ai-meta">(<%= ci['comments'] %> <%= l(:tomihub_kmap_comments) %> · <%= ci['changes'] %> <%= l(:tomihub_kmap_changes) %>)</span>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <% if ai['missing'].present? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_missing) %></strong> <%= ai['missing'] %></p>
            <% end %>
            <% onboarding = ai['onboarding'] || [] %>
            <% if onboarding.any? %>
              <p class="kmap-ai-line"><strong><%= l(:tomihub_kmap_onboarding) %></strong></p>
              <ol class="kmap-ai-steps">
                <% onboarding.each do |s| %>
                  <li><%= s['action'] %></li>
                <% end %>
              </ol>
            <% end %>
          </div>
        <% end %>
        <% if pages.any? %>
          <% if ai %><p class="kmap-ai-line kmap-docs-label"><%= l(:tomihub_kmap_docs) %></p><% end %>
          <div class="tomihub-kmap-pages">
            <% pages.each do |p| %>
              <a class="kmap-page-row" target="_blank" rel="noopener"
                 href="/projects/<%= project.identifier %>/wiki/<%= ERB::Util.url_encode(p['title']) %>">
                <span class="kmap-page-title">📄 <%= p['title'] %></span>
                <% if p['snippet'].present? %>
                  <span class="kmap-page-snippet"><%= p['snippet'] %></span>
                <% end %>
              </a>
            <% end %>
          </div>
        <% end %>
        <p class="tomihub-cta">
          <a class="tomihub-cta-btn" href="<%= settings['tomihub_url'] %>/project-knowledge?from=redmine-plugin" target="_blank" rel="noopener">
            <%= l(:tomihub_kmap_open) %> →
          </a>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
