<%
  # Free-tier summary badge. Server-side fetch (not browser JS): the
  # self-hosted TomiHub only needs to be reachable from THIS Redmine
  # server — never from end-user browsers. Cached 60s to keep page
  # renders fast.
  settings = Setting.plugin_redmine_tomihub
  configured = settings['tomihub_url'].present? && settings['api_key'].present?
  summary = nil
  summary_error = false
  if configured
    begin
      lang = ::I18n.locale.to_s.split('-').first
      summary = Rails.cache.fetch("tomihub_summary_#{project.id}_#{lang}", expires_in: 60.seconds) do
        RedmineTomihub::Client.new(settings['tomihub_url'], settings['api_key'])
                             .project_summary(project.id, lang)['data']
      end
    rescue RedmineTomihub::Client::Error, StandardError
      summary_error = true
    end
  end
  score = summary && summary['health_score']
  level = summary && summary['health_level']
%>

<% if !configured %>
  <div class="box tomihub-setup-prompt">
    <p><strong><%= l(:tomihub_unconfigured_title) %></strong></p>
    <p><%= l(:tomihub_unconfigured_hint) %></p>
  </div>
<% elsif summary_error %>
  <div class="box tomihub-setup-prompt">
    <p><%= l(:tomihub_unreachable) %></p>
  </div>
<% elsif score.nil? %>
  <div class="box tomihub-setup-prompt">
    <p><%= l(:tomihub_no_data) %></p>
  </div>
<% else %>
  <div class="box" id="tomihub-health">
    <div class="tomihub-badge tomihub-<%= level %>">
      <span class="tomihub-score"><%= score %></span>
      <span class="tomihub-label"><%= l(:tomihub_health_label) %> ·
        <%= level == 'healthy' ? l(:tomihub_level_healthy) : level == 'at_risk' ? l(:tomihub_level_at_risk) : l(:tomihub_level_critical) %>
      </span>
    </div>
    <% risks = (summary['top_risks'] || []).first(3) %>
    <% if risks.any? %>
      <ul class="tomihub-risks">
        <% risks.each do |r| %>
          <li>⚠ <%= r['title'] %></li>
        <% end %>
      </ul>
    <% end %>
    <p class="tomihub-cta">
      <a href="<%= settings['tomihub_url'] %>" target="_blank" rel="noopener">
        <%= l(:tomihub_full_analysis) %> →
      </a>
      <span class="tomihub-updated">· <%= l(:tomihub_updated) %> <%= summary['updated_at'].to_s[0, 16] %></span>
    </p>
  </div>
<% end %>
